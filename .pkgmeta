package-as: Smiler
enable-nolib-creation: no
manual-changelog: CHANGELOG.md
ignore:
  - README.md
  - CHANGELOG.md
  - .github
  - .pkgmeta
  - SmilerKeys/README.md
  - CDTimeline/README.md
  - Rewound/README.md
  - LustReady/README.md
move-folders:
  Smiler/SmilerKeys: SmilerKeys
  Smiler/CDTimeline: CDTimeline
  Smiler/Smiler_Fights: Smiler_Fights
  Smiler/RampNotes: RampNotes
  Smiler/DiedTo: DiedTo
  Smiler/Rewound: Rewound
  Smiler/LustReady: LustReady
  Smiler/SmilerSplits: SmilerSplits
  Smiler/SmilerPet: SmilerPet
  Smiler/SmilerBeacons: SmilerBeacons
  Smiler/SmilerStash: SmilerStash
  Smiler/SmilerVault: SmilerVault
